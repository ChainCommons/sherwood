{
  "name": "open-crypto-tax-commons",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && turbo run typecheck",
    "lint": "turbo run lint",
    "validate": "node packages/validate/bin/octc-validate.mjs",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
